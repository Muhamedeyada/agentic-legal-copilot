# =============================================================================
# Agentic Legal Copilot (D1T1) — environment template
# Copy to `.env` and replace dummy values. Never commit `.env`.
# =============================================================================

# --- Server ---
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
LOG_LEVEL=info
# Comma-separated when both Vite (5173) and Docker nginx (3000) are used
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000

# --- Client (Vite exposes only VITE_* ) ---
VITE_API_URL=http://localhost:3001
VITE_DEFAULT_LOCALE=en
VITE_SUPPORTED_LOCALES=ar,en

# --- Bilingual / locale ---
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=ar,en
RTL_ENABLED=true

# --- LLM completions (hosted adapter; swap via LLM_PROVIDER) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Embeddings (separate from chat so adapters can differ) ---
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# --- Local fallback (used when hosted provider is unavailable) ---
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=llama3.1
LOCAL_EMBEDDING_MODEL=nomic-embed-text

# --- Vector store ---
VECTOR_STORE_PROVIDER=chroma
CHROMA_URL=http://127.0.0.1:8000
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=qdrant-dummy-api-key
QDRANT_COLLECTION=legal_corpus_d1t1

# --- Persistence ---
DATABASE_URL=file:./data/runtime/app.db

# --- Uploads / corpus ---
MAX_UPLOAD_MB=20
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain
CORPUS_DIR=./data/corpus

# --- Human-in-the-loop ---
REQUIRE_COUNSEL_APPROVAL=true

# --- Security / consumption caps (Section 5) ---
RATE_LIMIT_PER_MINUTE=60
MAX_PROMPT_CHARS=12000
MAX_COMPLETION_CHARS=8000
MAX_UPLOAD_CHARS=200000

# --- Demo auth (replace before any shared deploy) ---
DEMO_API_TOKEN=replace-with-a-long-random-token

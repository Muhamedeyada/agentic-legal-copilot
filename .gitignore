data/uploads/
data/runtime/
*.sqlite
*.db

# Keep corpus placeholders; ignore dumped contract files unless they are synthetic
data/corpus/*.pdf
data/corpus/*.docx
data/corpus/*.txt
!data/corpus/.gitkeep
!data/corpus/README.md

